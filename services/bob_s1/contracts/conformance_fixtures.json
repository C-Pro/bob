      "endpoint": "/v1/chat/completions",
      "server_config": {"max_seq_len": 4096},
      "request": {
        "model": "bob-s1-0.8b",
        "messages": [{"role": "user", "content": "{\"protocol\":\"bob-s1.decision.v1\",\"state\":\"x\",\"decisions\":[{\"id\":\"d1\",\"question\":\"Q?\",\"options\":[{\"id\":\"a\",\"description\":\"A1\",\"value\":0.0},{\"id\":\"b\",\"description\":\"B1\"}]}]}"}]
      },
      "expected": {"status": 400, "error_type": "invalid_request_error"}
    },
    {
      "name": "chat_multi_question_joint_without_shared_prefix",
      "endpoint": "/v1/chat/completions",
      "server_config": {"max_seq_len": 4096},
      "request": {
        "model": "bob-s1-0.8b",
        "messages": [{"role": "user", "content": "{\"protocol\":\"bob-s1.decision.v1\",\"state\":\"x\",\"embedding\":{\"dimensions\":128},\"decisions\":[{\"id\":\"d1\",\"task\":\"compaction\"},{\"id\":\"d2\",\"task\":\"loop_guard\"}]}"}]
      },
      "expected": {"status": 400, "error_type": "invalid_request_error"}
    },
    {
      "name": "chat_apply_calibration_false_require_calibrated_true",
      "endpoint": "/v1/chat/completions",
      "server_config": {"max_seq_len": 4096},
      "request": {
        "model": "bob-s1-0.8b",
        "messages": [{"role": "user", "content": "{\"protocol\":\"bob-s1.decision.v1\",\"state\":\"x\",\"decisions\":[{\"id\":\"d1\",\"task\":\"compaction\",\"apply_calibration\":false,\"require_calibrated\":true}]}"}]
      },
      "expected": {"status": 400, "error_type": "invalid_request_error", "code": "calibration_conflict"}
    },
    {
      "name": "chat_require_calibrated_on_8k",
      "endpoint": "/v1/chat/completions",
      "server_config": {"max_seq_len": 8192},
      "request": {
        "model": "bob-s1-0.8b",
        "messages": [{"role": "user", "content": "{\"protocol\":\"bob-s1.decision.v1\",\"state\":\"x\",\"max_seq_len\":8192,\"decisions\":[{\"id\":\"d1\",\"task\":\"compaction\",\"require_calibrated\":true}]}"}]
      },
      "expected": {"status": 400, "error_type": "invalid_request_error", "code": "calibration_unavailable"}
    },
    {
      "name": "chat_contradictory_canonical_question_override",
      "endpoint": "/v1/chat/completions",
      "server_config": {"max_seq_len": 4096},
      "request": {
        "model": "bob-s1-0.8b",
        "messages": [{"role": "user", "content": "{\"protocol\":\"bob-s1.decision.v1\",\"state\":\"x\",\"decisions\":[{\"id\":\"d1\",\"task\":\"compaction\",\"question\":\"Altered question?\"}]}"}]
      },
      "expected": {"status": 400, "error_type": "invalid_request_error"}
    },
    {
      "name": "chat_budget_too_small_for_prefix_delimiter",
      "endpoint": "/v1/chat/completions",
      "server_config": {"max_seq_len": 4096},
      "request": {
        "model": "bob-s1-0.8b",
        "messages": [{"role": "user", "content": "{\"protocol\":\"bob-s1.decision.v1\",\"state\":\"x\",\"max_seq_len\":10,\"truncation\":\"head_tail\",\"decisions\":[{\"id\":\"d1\",\"task\":\"compaction\"}]}"}]
      },
      "expected": {"status": 400, "error_type": "invalid_request_error", "code": "context_length_exceeded"}
    }
  ],
  "response_rejection_cases": [
    {
