      "server_config": {"max_seq_len": 4096},
      "request": {
        "model": "bob-s1-0.8b",
        "messages": [{"role": "user", "content": "{\"protocol\":\"bob-s1.decision.v1\",\"state\":\"x\",\"decisions\":[{\"id\":\"d1\",\"question\":\"Q?\",\"options\":[{\"id\":\"a\",\"description\":\"A1\"},{\"id\":\"a\",\"description\":\"A2\"}]}]}"}]
      },
      "expected": {"status": 400, "error_type": "invalid_request_error"}
