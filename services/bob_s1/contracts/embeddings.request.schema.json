{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bob-s1/embeddings.request.schema.json",
  "title": "BobS1EmbeddingsRequest",
  "description": "OpenAI-compatible /v1/embeddings request with multimodal content extension. Multimodal items must order zero or more image_url parts before at most one text part.",
  "type": "object",
  "required": ["model", "input"],
  "additionalProperties": false,
  "properties": {
    "model": { "type": "string", "minLength": 1 },
    "input": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["content"],
            "additionalProperties": false,
            "properties": {
              "content": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["type", "image_url"],
                      "additionalProperties": false,
                      "properties": {
                        "type": { "const": "image_url" },
                        "image_url": {
                          "type": "object",
                          "required": ["url"],
                          "additionalProperties": false,
                          "properties": {
                            "url": {
                              "type": "string",
                              "pattern": "^data:image/(png|jpeg|webp|gif);base64,[A-Za-z0-9+/=]+$"
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": ["type", "text"],
                      "additionalProperties": false,
                      "properties": {
                        "type": { "const": "text" },
                        "text": { "type": "string" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "dimensions": { "type": "integer", "enum": [128, 256, 384], "default": 384 },
    "encoding_format": { "type": "string", "enum": ["float", "base64"], "default": "float" },
    "user": { "type": "string" },
    "truncation": { "type": "string", "enum": ["error", "head_tail"], "default": "error" },
    "max_seq_len": { "type": "integer", "minimum": 1, "maximum": 262144 }
  }
}
