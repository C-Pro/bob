{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bob-s1/decision.request.schema.json",
  "title": "BobS1DecisionProtocolRequest",
  "type": "object",
  "required": ["protocol", "state", "decisions"],
  "additionalProperties": false,
  "properties": {
    "protocol": { "const": "bob-s1.decision.v1" },
    "state": { "type": "string" },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "if": { "not": { "required": ["task"] } },
        "then": { "required": ["question", "options"] },
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "task": { "type": "string", "enum": ["compaction", "outcome_prefix", "loop_guard"] },
          "question": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 255,
            "items": {
              "type": "object",
              "required": ["id", "description"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "value": { "type": "number" }
              }
            }
          },
          "scoring_mode": { "type": "string", "enum": ["joint", "equivariant"], "default": "joint" },
          "apply_calibration": { "type": "boolean", "default": true },
          "require_calibrated": { "type": "boolean", "default": false }
        }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimensions": { "type": "integer", "enum": [128, 256, 384], "default": 384 },
        "encoding_format": { "type": "string", "enum": ["float", "base64"], "default": "float" }
      }
    },
    "prefix_mode": { "type": "string", "enum": ["per_question", "shared_prefix"], "default": "per_question" },
    "truncation": { "type": "string", "enum": ["head_tail", "error"], "default": "head_tail" },
    "max_seq_len": { "type": "integer", "minimum": 1, "maximum": 262144 }
  },
  "if": {
    "required": ["embedding"],
    "properties": {
      "decisions": { "minItems": 2 }
    }
  },
  "then": {
    "required": ["prefix_mode"],
    "properties": {
      "prefix_mode": { "const": "shared_prefix" }
    }
  }
}
