{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bob-s1/embeddings.response.schema.json",
  "title": "BobS1EmbeddingsResponse",
  "description": "OpenAI-compatible /v1/embeddings response. Semantic validation additionally verifies len(data) == len(input), contiguous indices 0..N-1, vector length == requested dimensions, decoded base64 byte length == 4 * dimensions, and finite float32 elements.",
  "type": "object",
  "required": ["object", "data", "model", "usage"],
  "additionalProperties": false,
  "properties": {
    "object": { "const": "list" },
    "model": { "type": "string", "minLength": 1 },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["object", "index", "embedding"],
        "additionalProperties": false,
        "properties": {
          "object": { "const": "embedding" },
          "index": { "type": "integer", "minimum": 0 },
          "embedding": {
            "oneOf": [
              { "type": "array", "minItems": 128, "maxItems": 128, "items": { "type": "number" } },
              { "type": "array", "minItems": 256, "maxItems": 256, "items": { "type": "number" } },
              { "type": "array", "minItems": 384, "maxItems": 384, "items": { "type": "number" } },
              { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9+/=]+$" }
            ]
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "required": ["prompt_tokens", "total_tokens"],
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
